# Copy to .env and adjust. Never commit .env.

# --- Local reasoning model (OpenAI-compatible endpoint, served OUTSIDE this repo) ---
# Saravanan owns the model runtime. This service only needs the URL.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=local
LLM_MODEL=gpt-oss-120b
LLM_TIMEOUT_SECONDS=180
LLM_MAX_OUTPUT_TOKENS=4096

# Set to true to run the whole pipeline with the deterministic rule-based
# adapter instead of the real model (no model server required).
USE_FAKE_LLM=false

# --- Embeddings (optional) ---
# Absolute path to a locally downloaded sentence-transformers model directory.
# Nothing is ever downloaded at runtime. Leave empty for BM25-only retrieval,
# which is enough for extraction; the dense side is for natural-language "Ask".
EMBEDDING_MODEL_PATH=
# Deterministic hashing embeddings, for testing hybrid retrieval without weights.
USE_FAKE_EMBEDDINGS=false

# Instruction prefixes the encoder was trained with. Getting these wrong costs
# accuracy silently, so check the model card. Examples:
#   BAAI/bge-small-en-v1.5   query "Represent this sentence for searching relevant passages: ", document ""
#   intfloat/e5-small-v2     query "query: ", document "passage: "
#   all-MiniLM-L6-v2         none
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=

# --- Storage / service ---
RAG_DATA_DIR=./runtime-data
RAG_HOST=127.0.0.1
RAG_PORT=8001

# --- Chunking / retrieval tuning ---
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
DEFAULT_TOP_K=6
RRF_K=60

# --- Verification thresholds ---
FUZZY_MATCH_THRESHOLD=0.92
FUZZY_MAX_LENGTH_RATIO=1.35
